[Unit]
Description=Ensure /etc/shadow is group=shadow so PAM's unix_chkpwd can read it (see FIXES-V33/V34)
# CLAUDE_DEBUG 2026-09-05: halium-restore-state.sh already does this same
# chgrp, but it runs very early (After=local-fs.target, Before=
# NetworkManager/bluetooth) -- live-observed on a real clean flash+wipe
# that /etc/shadow ends up group=root anyway despite that script
# reporting SUCCESS, meaning something LATER in first-boot (user/password
# provisioning) recreates /etc/shadow and resets its group. This unit is
# ordered After=multi-user.target specifically so it runs LAST, after
# whatever does that provisioning, and actually sticks.
After=multi-user.target

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'chgrp shadow /etc/shadow || true'
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
