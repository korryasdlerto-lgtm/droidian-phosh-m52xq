[Unit]
Description=Directly exec the camera HAL provider, bypassing patched init's broken ctl.start (see FIXES-V32 7.5)
# CLAUDE_DEBUG 2026-09-05 (в36): НЕ WantedBy=multi-user.target -- этот
# юнит больше не стартует сам по себе при загрузке. Он стартуется/
# рестартуется ИСКЛЮЧИТЕЛЬНО по требованию, из halium-camera-ondemand-
# refresh.service (systemctl restart), который сам триггерится нажатием
# иконки Камеры (см. halium-camera-launch.sh /
# halium-camera-ondemand-refresh.path). Юнит-файл просто должен лежать
# в /usr/lib/systemd/system/, чтобы `systemctl restart` мог найти его
# по имени -- [Install]/enable для этого не нужен вовсе.
After=lxc-android-config.service
Requisite=lxc-android-config.service

[Service]
Type=simple
ExecStart=/usr/libexec/halium-camera-provider-direct-start.sh
Restart=always
RestartSec=3
