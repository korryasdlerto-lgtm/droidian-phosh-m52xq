@@ -1353,6 +1420,35 @@ phosh_screenshot_manager_new (void)
   return PHOSH_SCREENSHOT_MANAGER (g_object_new (PHOSH_TYPE_SCREENSHOT_MANAGER, NULL));
 }
 
+typedef struct {
+  PhoshScreenshotManager *self;
+  gboolean                has_area;
+  GdkRectangle            area;
+  char                   *filename;
+  gboolean                copy_to_clipboard;
+  gboolean                include_cursor;
+} DirectScreenshotData;
+
+
+static gboolean
+on_take_screenshot_settle_timeout (gpointer user_data)
+{
+  DirectScreenshotData *data = user_data;
+  PhoshScreenshotManager *self = data->self;
+
+  phosh_screenshot_manager_do_screenshot (self, data->has_area ? &data->area : NULL, data->include_cursor);
+  /* frames can be NULL here on failure, same as the original
+   * synchronous code below did not guard against either - do_screenshot
+   * itself already g_debug()s and bails out cleanly in that case. */
+  if (self->frames)
+    self->frames->copy_to_clipboard = data->copy_to_clipboard;
+
+  g_free (data->filename);
+  g_free (data);
+  return G_SOURCE_REMOVE;
+}
+
+
 /**
  * phosh_screenshot_manager_take_screenshot:
  * @self: The screenshot manager
@@ -1364,7 +1460,15 @@ phosh_screenshot_manager_new (void)
  * Initiate a screenshot of all outputs or the given area. If `copy_to_clipboard` is
  * `TRUE` the screenshot is also copied to the clipboard.
  *
- * Returns: `FALSE` on failure, otherwise `TRUE`
+ * The actual capture happens after a short settle delay (see
+ * SCREENSHOT_SETTLE_MS above handle_screenshot()) so that in-process
+ * callers who just dismissed their own UI right before calling this
+ * (the power-menu's Screenshot button, the global screenshot
+ * keybinding) don't get that UI baked into the shot.
+ *
+ * Returns: `TRUE` (the capture is now scheduled; failure, if any,
+ * happens asynchronously and is only logged, matching how the
+ * existing in-tree callers already ignore this return value)
  */
 gboolean
 phosh_screenshot_manager_take_screenshot (PhoshScreenshotManager *self,
@@ -1373,10 +1477,17 @@ phosh_screenshot_manager_take_screenshot (PhoshScreenshotManager *self,
                                           gboolean                copy_to_clipboard,
                                           gboolean                include_cursor)
 {
-  gboolean ret;
+  DirectScreenshotData *data = g_new0 (DirectScreenshotData, 1);
 
-  ret = phosh_screenshot_manager_do_screenshot (self, area, include_cursor);
-  self->frames->copy_to_clipboard = copy_to_clipboard;
+  data->self = self;
+  data->has_area = area != NULL;
+  if (area)
+    data->area = *area;
+  data->filename = g_strdup (filename);
+  data->copy_to_clipboard = copy_to_clipboard;
+  data->include_cursor = include_cursor;
+
+  g_timeout_add (SCREENSHOT_SETTLE_MS, on_take_screenshot_settle_timeout, data);
 
-  return ret;
+  return TRUE;
 }
