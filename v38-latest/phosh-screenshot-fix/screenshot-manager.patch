+/* Any screenshot request - whether it came in over DBus or via the
+ * public phosh_screenshot_manager_take_screenshot() C API used
+ * in-process by the power-menu's own "Screenshot" button and the
+ * global screenshot keybinding/action - can be triggered in the very
+ * same call as something else on screen (that same button's own menu,
+ * most commonly) getting dismissed a moment earlier. Dismissing a GTK
+ * widget (gtk_widget_destroy() et al) is synchronous, but the
+ * corresponding Wayland surface teardown reaching phoc (a separate
+ * process) and phoc actually compositing a frame without it is not -
+ * grabbing immediately can and does still capture the
+ * just-closed menu. Giving the compositor a short, fixed settle
+ * window before the actual zwlr_screencopy grab avoids this
+ * regardless of what was closing or why - deliberately not trying to
+ * track any particular widget/state for this, see the huge amount of
+ * live back-and-forth needed to nail this exact race down. */
+#define SCREENSHOT_SETTLE_MS 1000
+
+typedef struct {
+  PhoshScreenshotManager *self;
+  GDBusMethodInvocation  *invocation;
+  gboolean                is_area;
+  GdkRectangle            area;
+  gboolean                include_cursor;
+  gboolean                flash;
+  char                   *filename_pattern;
+} ScreenshotRequestData;
+
+
+static void
+screenshot_request_data_free (ScreenshotRequestData *data)
+{
+  g_free (data->filename_pattern);
+  g_free (data);
+}
+
+
+static gboolean
+on_screenshot_settle_timeout (gpointer user_data)
+{
+  ScreenshotRequestData *data = user_data;
+  PhoshScreenshotManager *self = data->self;
+  gboolean success;
+
+  success = phosh_screenshot_manager_do_screenshot (
+    self, data->is_area ? &data->area : NULL, data->include_cursor);
+  if (!success) {
+    if (data->is_area)
+      phosh_dbus_screenshot_complete_screenshot_area (PHOSH_DBUS_SCREENSHOT (self), data->invocation, FALSE, "");
+    else
+      phosh_dbus_screenshot_complete_screenshot (PHOSH_DBUS_SCREENSHOT (self), data->invocation, FALSE, "");
+  } else {
+    self->frames->flash = data->flash;
+    self->frames->invocation = data->invocation;
+    self->frames->filename = build_dbus_filename (data->filename_pattern);
+    self->frames->copy_to_clipboard = !self->frames->filename;
+  }
+
+  screenshot_request_data_free (data);
+  return G_SOURCE_REMOVE;
+}
+
+
+/* Was the tail of handle_screenshot / handle_screenshot_area - now
+ * always waits out SCREENSHOT_SETTLE_MS before the actual grab, see
+ * the comment above SCREENSHOT_SETTLE_MS. */
+static void
+execute_screenshot_request (PhoshScreenshotManager *self,
+                            GDBusMethodInvocation  *invocation,
+                            gboolean                is_area,
+                            const GdkRectangle     *area,
+                            gboolean                include_cursor,
+                            gboolean                flash,
+                            const char             *filename_pattern)
+{
+  ScreenshotRequestData *data = g_new0 (ScreenshotRequestData, 1);
+
+  data->self = self;
+  data->invocation = invocation;
+  data->is_area = is_area;
+  if (is_area)
+    data->area = *area;
+  data->include_cursor = include_cursor;
+  data->flash = flash;
+  data->filename_pattern = g_strdup (filename_pattern);
+
+  g_timeout_add (SCREENSHOT_SETTLE_MS, on_screenshot_settle_timeout, data);
+}
+
+
 static gboolean
 handle_screenshot_area (PhoshDBusScreenshot   *object,
                         GDBusMethodInvocation *invocation,
